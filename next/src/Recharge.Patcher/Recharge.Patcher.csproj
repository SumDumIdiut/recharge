    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Recharge.Patcher</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
