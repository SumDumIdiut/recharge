<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Recharge.App</RootNamespace>
    <AssemblyName>Recharge.App</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.2</Version>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- lets `dotnet publish -r win-x64` run from Linux -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon Condition="Exists('$(MSBuildProjectDirectory)/Windows/recharge.ico')">Windows/recharge.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <!-- a GUI exe: no console window -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
  <!-- WebView2Loader.dll must sit beside the exe: the package leaves it in runtimes/win-x64/native, where nothing finds it at run
       time (DllNotFoundException on the first CoreWebView2Environment call, seen in the Windows VM). -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <None Include="$(NuGetPackageRoot)microsoft.web.webview2/1.0.4314.35/runtimes/win-x64/native/WebView2Loader.dll" Link="WebView2Loader.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Recharge.Core/Recharge.Core.csproj" />
    <ProjectReference Include="../Recharge.Net/Recharge.Net.csproj" />
    <ProjectReference Include="../Recharge.Link/Recharge.Link.csproj" />
    <ProjectReference Include="../Recharge.Patcher/Recharge.Patcher.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core API only (no WinForms/WPF), used by the plain Win32 shell in Windows/ -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" PrivateAssets="all" />
  </ItemGroup>
  <!-- The package's targets also reference its WPF and WinForms assemblies; the shell uses neither (plain Win32 + Core API), so drop them. -->
  <Target Name="DropWebView2Ui" BeforeTargets="ResolveAssemblyReferences;ResolveAssemblyReferencesDesignTime;FindReferenceAssembliesForReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="$([System.String]::Copy('%(Filename)').EndsWith('WebView2.Wpf')) Or $([System.String]::Copy('%(Filename)').EndsWith('WebView2.WinForms'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Content Include="ui/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- RechargeLoader 2: shipped as loader/, installed into the game by Settings > Game (refreshed by tools/stage-loader.sh, committed because CI has no game to compile it) -->
    <Content Include="loader/*.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../assets/logo.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
