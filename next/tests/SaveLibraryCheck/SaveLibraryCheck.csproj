<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- SaveLibrary.cs is built with the Maps module's nullable annotations disabled. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Recharge.Module.Maps/SaveLibrary.cs" Link="SaveLibrary.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
