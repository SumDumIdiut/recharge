{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recharge",
  "version": "1.2.5",
  "identifier": "co.za.codecade.recharge",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Recharge",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../loader/ModApi": "loader/ModApi",
      "../../loader/Runtime": "loader/Runtime",
      "../../loader/tools": "loader/tools",
      "../../loader/build-loader.ps1": "loader/build-loader.ps1",
      "../../mods/recharge-maps": "mods/recharge-maps"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
