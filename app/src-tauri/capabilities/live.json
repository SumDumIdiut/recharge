{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "live",
  "description": "The live-updated screens, served from the app's own local server",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:39285",
      "http://127.0.0.1:39285/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "opener:default",
    "dialog:default",
    "app-commands"
  ]
}
